# systemd USER unit for the pilot's loom server (PLAN §T7.1).
# Install it with:
#   mkdir -p ~/.config/systemd/user
#   cp server/loom-server.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now loom-server
#   loginctl enable-linger "$USER"   # so it survives logging out
#
# Pilot: bind ONLY to 127.0.0.1 (no TLS — see the phase-3 TODO in docs/RUNBOOK.md).
# %h is your HOME; adjust the checkout path if the repo lives elsewhere.
[Unit]
Description=Synaptic Loom API server (pilot, localhost only)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/synaptic-loom
Environment=LOOM_DB=%h/.loom-server/loom.db
ExecStart=%h/synaptic-loom/.venv/bin/python -m uvicorn server.app:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
