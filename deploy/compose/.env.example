# Copy to `.env` next to docker-compose.yml and edit. `.env` is gitignored.
#
# The public hostname of this server. Its DNS A (and AAAA, if the host has IPv6) record
# must point at this host before the first `docker compose up`, and ports 80 and 443 must
# be reachable from the internet: Caddy obtains the certificate for it automatically.
LOOM_DOMAIN=loom.example.com
